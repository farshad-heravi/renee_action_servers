bool success
string message
string resolved_camera_link
geometry_msgs/PoseStamped base_pose
geometry_msgs/PoseStamped end_effector_pose
sensor_msgs/JointState arm_solution
float64 score
---
string phase
uint32 candidates_evaluated
uint32 valid_candidates
